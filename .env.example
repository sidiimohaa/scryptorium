# ── SCRYPTORIUM — variables d'environnement ──────────────────────────────
# Copier vers .env.local (jamais commité). Seules les variables NEXT_PUBLIC_* atteignent le navigateur.

# URL publique du site (SEO, sitemap, redirection OAuth Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bureau du Bibliothécaire (obligatoire pour administrer)
ADMIN_PASSWORD=
# 32 caractères minimum — ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Supabase (facultatif en local, recommandé en production) — sinon : archive locale data/library.json
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comptes lecteurs (clé publique « anon » ou « publishable » : sans danger côté navigateur, la RLS protège)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive — méthode 2 (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Books — quota étendu (facultatif ; Open Library fonctionne sans clé)
GOOGLE_BOOKS_API_KEY=

# Assistant de lecture IA (facultatif)
ANTHROPIC_API_KEY=
